DATA_DIR=data
WORKER_ID=recognizer-1
WORKER_TOKEN=
# B initiates this connection. Use WSS publicly, or loopback WS through SSH.
UPLOADER_WS_URL=ws://127.0.0.1:18092/internal/v1/worker/connect
STATISTICS_URL=https://statistics.example.com
STATISTICS_TOKEN=
PAN_CLIENT_ID=
PAN_CLIENT_SECRET=
PAN_API_BASE=https://open-api.123pan.com
# When configured, B downloads by SHA-256 filename over WebDAV, without OpenAPI calls.
# Point this URL at the same directory A uploads to; never embed credentials in it.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
ALAS_ROOT=../AzurLaneAutoScript
# Python with the matching Alas OCR dependencies and models installed.
ALAS_PYTHON=../AzurLaneAutoScript/.venv/bin/python
RECOGNITION_TIMEOUT=600
# Independent executors with feedback-controlled concurrency. 0 = derive a
# ceiling from hardware; positive values optionally set operator ceilings.
PIPELINE=staged
AUTO_TUNE=true
DOWNLOAD_WORKERS=0
VERIFY_WORKERS=0
OCR_SLOTS=0
DELIVER_WORKERS=0
DOWNLOAD_AHEAD=0
OCR_PROCESSES=0
# 0 = up to 2 GiB / one quarter of free disk, fits at least one group.
WORK_MAX_BYTES=0
# B-only bounded tmpfs cache, 0 = automatic (up to 512 MiB), -1 = disk only.
# Increase the container shm_size to make this space available.
MEMORY_CACHE_BYTES=0
# Legacy one-lane pipeline; only for rollback.
# PIPELINE=inline
# Kept for compatibility with older configurations.
RECOGNITION_WORKERS=0
OCR_THREADS=1
PREFETCH_JOBS=0
OCR_PROCESS_MAX_JOBS=1000
MAX_FILE_BYTES=10485760
MAX_GROUP_BYTES=524288000
# Base64 raw Ed25519 public key, pinned out of band. When set, every package
# must carry X-Content-Signature; unsigned/corrupted packages keep the old release.
TEMPLATE_PUBLIC_KEY=
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8091
